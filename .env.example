# ── OpenAI / compatible provider ──────────────────────────────────────────
# OpenAI: set OPENAI_API_KEY and leave BASE_URL empty
# Ollama (local, free): OPENAI_API_KEY=ollama  OPENAI_BASE_URL=http://localhost:11434/v1
# Groq:   OPENAI_API_KEY=gsk_...               OPENAI_BASE_URL=https://api.groq.com/openai/v1
# Mistral:OPENAI_API_KEY=...                   OPENAI_BASE_URL=https://api.mistral.ai/v1
# LM Studio: OPENAI_API_KEY=lm-studio         OPENAI_BASE_URL=http://localhost:1234/v1

OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o

# For Ollama example:
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=qwen2.5-coder
